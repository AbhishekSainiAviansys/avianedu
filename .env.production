# ==========================================================================
# AVIANEdu â€” PRODUCTION environment template
# Activate with:   composer env:prod   (copies this file to .env)
#
# Hardened settings: no debug output, warning-level daily logs,
# file-based sessions & cache â€” works on ANY host without a database.
# ==========================================================================
APP_NAME=AvianEdu
APP_ENV=production
# Use a FRESH key on every server:  php artisan key:generate --force
APP_KEY=base64:e/CL9T8F8+odCzALQa2nNSRBR4xnD4UvNQf52HojsJs=
# Never expose stack traces on a live site:
APP_DEBUG=false
# TODO: replace with your real domain before going live
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs: one file per day, warnings and above only
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Kept for optional use (switch SESSION/CACHE back to "database" to activate).
# With the file drivers below, this site runs with NO database at all.
DB_CONNECTION=sqlite

# File-based session & cache => portable to any shared host / container
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_DRIVER=log
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
CACHE_DRIVER=file

# Point MAIL_* at a real SMTP relay when you enable outbound email
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@avianedu.in"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
